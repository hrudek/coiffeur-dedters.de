---
import { Image } from "astro:assets";
import SectionHeading from "../SectionHeading.astro";
import TeamCard from "../TeamCard.astro";
import teamImage from "../../assets/team/team-salon.jpg";
import justine from "../../assets/team/justine.jpg";
import conny from "../../assets/team/conny.jpg";
import mitarbeiterin1 from "../../assets/team/mitarbeiterin-1.jpg";
import mitarbeiterin2 from "../../assets/team/mitarbeiterin-2.jpg";
import mitarbeiterin3 from "../../assets/team/mitarbeiterin-3.jpg";
---

<section id="team" class="section bg-anthracite text-paper">
  <div class="container-content">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-end">
      <SectionHeading kicker="Wir freuen uns auf dich" title="Unser Team" tone="dark" />
      <div class="space-y-4 leading-relaxed text-paper/75">
        <p>
          Bei Coiffeur Dedters bist du immer in professionellen Händen. Unser Team beherrscht nicht nur das klassische
          Frisurenrepertoire, sondern auch die jeweils top-aktuellen Stylings der Saison. Unser Leistungsspektrum wird
          dabei ideal durch unser Angebot an TOP Pflegeprodukten ergänzt.
        </p>
        <p>
          Gerne vereinbaren wir einen unverbindlichen Beratungstermin mit dir. Unser Fachpersonal steht dir mit Rat und
          Tat zur Seite!
        </p>
      </div>
    </div>

    <figure class="mt-14 overflow-hidden rounded-sm border border-white/10">
      <Image
        src={teamImage}
        alt="Das Team von Coiffeur Dedters lacht gemeinsam mit Sekt im Salon"
        widths={[640, 960, 1280, 1920]}
        sizes="(min-width: 1280px) 72rem, 100vw"
        class="aspect-[16/9] w-full object-cover md:aspect-[21/9] md:object-[50%_30%]"
      />
    </figure>

    <div class="mt-16 grid gap-x-6 gap-y-12 sm:grid-cols-2 xl:grid-cols-3">
      <TeamCard name="Justine" image={justine} alt="Porträt von Justine Dedters" tags={["Inhaberin in 2. Generation", "Friseurmeisterin"]}>
        <p>
          Seit 2008 ist Justine Teil von Coiffeur Dedters und führt das Familienunternehmen heute mit Leidenschaft in
          zweiter Generation. Ihre Stärken liegen in individuellen Farbtechniken, modernen Haarschnitten und exklusivem
          Brautstyling.
        </p>
        <p>
          Über sieben Jahre war sie als Fachtrainerin für Wella tätig und gab ihr Wissen an andere Friseure weiter. Heute
          widmet sie ihre ganze Erfahrung, Kreativität und Leidenschaft ihrem eigenen Salon und ihrem Team.
        </p>
      </TeamCard>
      <TeamCard name="Conny" image={conny} tags={["Gründerin", "Seele unseres Salons"]} alt="Porträt von Conny Dedters">
        <p>
          Als Mitgründerin von Coiffeur Dedters im Jahr 1983 steht Conny für die erste Generation unseres
          Familienunternehmens. Bis heute unterstützt sie uns an zwei Tagen in der Woche mit ihrer langjährigen Erfahrung.
        </p>
        <p>
          Ihre Stärken liegen in Dauerwellen, klassischen Föhnfrisuren und individuellen Colorationen. Mit viel Herz und
          Leidenschaft ist sie bis heute ein wertvoller Teil unseres Teams.
        </p>
      </TeamCard>
      <TeamCard name="Stephie" tags={["Langhaar- & Farbspezialistin"]} image={mitarbeiterin1} alt="Porträt von Stephie">
        <p>
          Seit 2022 ist Stephie Teil unseres Teams und unterstützt uns an ein bis zwei Tagen in der Woche.
        </p>
        <p>
          Ihre Leidenschaft gilt langen Haaren, modernen Balayage-Techniken und individuellen Farbkreationen. Auch bei
          trendigen Herrenhaarschnitten überzeugt sie mit ihrem Gespür für aktuelle Styles.
        </p>
      </TeamCard>
      <TeamCard name="Romina" tags={["Farbexpertin", "Styling-Spezialistin"]} image={mitarbeiterin2} alt="Porträt von Romina">
        <p>
          Seit 2024 bereichert Romina unser Team in Vollzeit mit ihrer Kreativität und langjährigen Erfahrung. Zuvor war
          sie 16 Jahre als Salonleitung tätig.
        </p>
        <p>
          Ihre Stärken liegen in modernen Farbtechniken wie Balayage und Airtouch, außergewöhnlichen Damenhaarschnitten
          und individuellem Brautstyling. Mit ihrem Gespür für Trends und ihrer Liebe zum Detail kreiert sie einzigartige
          Looks.
        </p>
      </TeamCard>
      <TeamCard name="Susanne" tags={["Klassische Frisuren", "Strähnentechniken"]} image={mitarbeiterin3} alt="Porträt von Susanne">
        <p>
          Seit 2022 ist Susanne ein fester Bestandteil unseres Teams und unterstützt uns in Vollzeit.
        </p>
        <p>
          Ihre Stärken liegen in präzisen Strähnentechniken, Dauerwellen und klassischen Frisuren. Mit ihrer Erfahrung und ihrem
          Organisationstalent sorgt sie nicht nur für schöne Haare, sondern auch für einen reibungslosen Salonalltag.
        </p>
      </TeamCard>
      <TeamCard name="Alisha" tags={["Nachwuchstalent"]}>
        <p>
          Seit 2025 bereichert Alisha als Auszubildende unser Team. Schon jetzt zeigt sie ihre Leidenschaft und ihr Talent
          für Beauty und Styling.
        </p>
        <p>
          Besonders im Bereich Augenbrauen und Make-up hat sie sich bereits zu einer Spezialistin
          entwickelt. Mit viel Kreativität, Engagement und Liebe zum Detail bringt sie frischen Wind in unseren Salon.
        </p>
      </TeamCard>
    </div>
  </div>
</section>
