---
import SectionHeading from "../SectionHeading.astro";
import ContactForm from "../ContactForm.astro";
import WhatsAppIcon from "../WhatsAppIcon.astro";
import { PHONE_DISPLAY, PHONE_HREF, WHATSAPP_HREF } from "../../data/contact";

const item = "font-serif text-xs tracking-[0.25em] text-stone uppercase";
const link = "transition-colors hover:text-accent";
---

<section id="kontakt" class="section bg-paper">
  <div class="container-content grid gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-24">
    <div>
      <SectionHeading kicker="Schick uns eine Nachricht" title="Kontakt" />
      <p class="mt-10 leading-relaxed text-ink/80">
        Du hast Fragen zu unseren Leistungen, Produkten oder Preisen? Schreib uns gern eine E-Mail oder nutze das
        Kontaktformular. Wir freuen uns auf dich!
      </p>

      <div class="mt-8 border-l-2 border-accent pl-5 leading-relaxed">
        <p class="font-serif text-xs tracking-[0.25em] text-accent uppercase">Termin vereinbaren</p>
        <p class="mt-3 text-ink/80">Ruf uns an, schreib uns per WhatsApp oder komm einfach im Salon vorbei.</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={PHONE_HREF} class="btn btn-dark">{PHONE_DISPLAY}</a>
          <a href={WHATSAPP_HREF} target="_blank" rel="noopener" class="btn btn-outline-dark">
            <WhatsAppIcon />
            WhatsApp
          </a>
        </div>
        <p class="mt-5 text-sm text-stone">
          Bitte keine Termine, Absagen oder Verschiebungen per E-Mail oder Kontaktformular.
        </p>
      </div>

      <dl class="mt-12 space-y-7">
        <div>
          <dt class={item}>Adresse</dt>
          <dd class="mt-2 leading-relaxed">
            <address class="not-italic">Coiffeur Dedters<br />Kurt-Schumacher-Allee 6<br />47445 Moers</address>
          </dd>
        </div>
        <div>
          <dt class={item}>Telefon</dt>
          <dd class="mt-2 font-serif text-xl tracking-wider"><a href="tel:+49284143970" class={link}>+49 (0) 2841 43970</a></dd>
        </div>
        <div>
          <dt class={item}>E-Mail</dt>
          <dd class="mt-2">
            <a href="mailto:coiffeur-dedters@t-online.de" class={`${link} underline decoration-line underline-offset-4`}
              >coiffeur-dedters@t-online.de</a
            >
          </dd>
        </div>
      </dl>
    </div>

    <div class="border border-line bg-paper p-6 sm:p-10 lg:p-12">
      <h3 class="mb-8 font-serif text-xl tracking-[0.15em] uppercase">Nachricht schreiben</h3>
      <ContactForm />
    </div>
  </div>
</section>
