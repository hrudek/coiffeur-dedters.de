---
import { Image } from "astro:assets";
import SectionHeading from "../SectionHeading.astro";
import HighlightCard from "../HighlightCard.astro";
import PriceList from "../PriceList.astro";
import PriceRow from "../PriceRow.astro";
import balayageImage from "../../assets/team/mitarbeiterin-1.jpg";
import airtouchImage from "../../assets/salon/foehnen.jpg";
import extensionsImage from "../../assets/team/mitarbeiterin-2.jpg";
import serviceImage from "../../assets/salon/haarwaesche.jpg";
---

<section id="leistungen" class="section bg-paper">
  <div class="container-content">
    <SectionHeading kicker="Was wir für dich tun" title="Leistungen & Preise" />

    <!-- Highlights: Balayage, AirTouch & Extensions -->
    <div id="balayage-airtouch" class="mt-14 grid gap-6 lg:grid-cols-3">
      <HighlightCard
        kicker="Unsere Spezialität"
        title="Balayage"
        image={balayageImage}
        alt="Lange, mehrfarbig blonde Wellen"
        cta="Beratung anfordern"
      >
        <p>
          Natürlich, lebendig und individuell – bei der Balayage-Technik werden sanfte Farbreflexe freihändig in dein Haar
          gemalt. So entstehen weiche, fließende Übergänge und ein besonders natürliches Farbergebnis, wie von der Sonne
          geküsst. Das Beste daran: Die Farbe wächst harmonisch heraus, ganz ohne festen Rhythmus für deinen nächsten
          Friseurbesuch.
        </p>
      </HighlightCard>
      <HighlightCard
        kicker="Unsere Spezialität"
        title="AirTouch"
        image={airtouchImage}
        alt="Föhnen im Salon, im Spiegel gesehen"
        cta="Beratung anfordern"
      >
        <p>
          Eine innovative Technik für besonders sanfte Aufhellungen und fließende Farbverläufe. Durch die präzise Anwendung
          entstehen natürliche, weiche Übergänge und ein strahlendes Farbergebnis – bei möglichst schonender Behandlung
          deines Haares.
        </p>
      </HighlightCard>
      <HighlightCard
        kicker="Unsere Spezialität"
        title="Extensions"
        image={extensionsImage}
        alt="Porträt einer Mitarbeiterin mit langen, rotbraunen Haaren"
        cta="Beratung anfordern"
      >
        <p>
          Ob mehr Fülle oder traumhaft langes Haar – mit unseren hochwertigen Tape-Extensions aus Echthaar erfüllen wir
          deine Haarwünsche.
        </p>
        <p class="mt-3">
          Dank hauchdünner, nahezu unsichtbarer Verbindungen sorgen wir für natürliches Volumen, zusätzliche Länge und ein
          harmonisches Ergebnis, das sich perfekt in dein Eigenhaar einfügt.
        </p>
      </HighlightCard>
    </div>

    <!-- Preisliste -->
    <div class="mt-24 grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:gap-20">
      <div>
        <p class="max-w-2xl leading-relaxed text-ink/80">
          Hier findest du unsere aktuelle Preisliste. Du hast spezielle Wünsche oder Fragen? Kein Problem, wir sind für
          dich da! Schreib uns einfach eine E-Mail, oder, was noch besser ist: Schau bei uns vorbei. Termine vereinbarst
          du bitte telefonisch, per WhatsApp oder persönlich im Salon. Wir freuen uns auf deinen Besuch!
        </p>

        <div class="mt-12 grid gap-12 md:grid-cols-2 md:gap-x-12">
          <PriceList title="Damen">
            <PriceRow service="Waschen, schneiden, föhnen" price="ab 54,00 €" />
            <PriceRow service="Farbe inkl. Pflege" price="ab 56,00 €" />
            <PriceRow service="Waschen, föhnen" price="ab 26,50 €" />
            <PriceRow service="Dauerwelle inkl. Pflege" price="ab 75,00 €" />
          </PriceList>
          <PriceList title="Farbe & Techniken">
            <PriceRow service="Balayage" price="auf Anfrage" />
            <PriceRow service="AirTouch" price="auf Anfrage" />
            <PriceRow service="Extensions" price="auf Anfrage" />
          </PriceList>
          <PriceList title="Kosmetik">
            <PriceRow service="Augenbrauen zupfen" price="ab 7,50 €" />
            <PriceRow service="Augenbrauen färben" price="13,00 €" />
            <PriceRow service="Wimpern färben" price="13,00 €" />
          </PriceList>
          <PriceList title="Herren">
            <PriceRow service="Waschen, schneiden, föhnen" price="ab 31,50 €" />
          </PriceList>
        </div>

        <p class="mt-12 border-l-2 border-accent pl-5 font-serif tracking-wider">
          Frag uns – wir sagen dir vorher, was du zahlst!
        </p>
      </div>

      <figure class="relative hidden lg:block">
        <Image
          src={serviceImage}
          alt="Eine Mitarbeiterin wäscht einer Kundin die Haare"
          widths={[400, 700]}
          sizes="22rem"
          class="sticky top-12 aspect-[2/3] w-full object-cover object-top"
        />
      </figure>
    </div>
  </div>
</section>
