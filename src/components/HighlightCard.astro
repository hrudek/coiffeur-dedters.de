---
/** Großer Highlight-Block für Spezialitäten (Balayage, AirTouch). */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  kicker: string;
  title: string;
  image: ImageMetadata;
  alt: string;
  cta: string;
  href?: string;
  imagePosition?: string;
}

const { kicker, title, image, alt, cta, href = "#kontakt", imagePosition = "center" } = Astro.props;
---

<article class="group relative isolate flex min-h-[32rem] flex-col justify-end overflow-hidden bg-night text-paper">
  <Image
    src={image}
    alt={alt}
    widths={[480, 720, 960]}
    sizes="(min-width: 768px) 40vw, 95vw"
    class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-1000 group-hover:scale-105"
    style={`object-position: ${imagePosition}`}
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-night via-night/75 to-night/10"></div>
  <div class="p-8 md:p-10">
    <p class="mb-3 font-serif text-xs tracking-[0.35em] text-accent-light uppercase">{kicker}</p>
    <h3 class="font-serif text-3xl tracking-wider uppercase md:text-4xl">{title}</h3>
    <span aria-hidden="true" class="my-5 block h-px w-14 bg-accent-light"></span>
    <div class="max-w-md text-[0.975rem] leading-relaxed text-paper/80">
      <slot />
    </div>
    <a href={href} class="btn btn-outline-light mt-7">{cta}</a>
  </div>
</article>
