---
/** Schwebender WhatsApp-Button, nur auf Mobilgeräten (unter lg) sichtbar. */
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { WHATSAPP_HREF } from "../data/contact";
---

<a
  href={WHATSAPP_HREF}
  target="_blank"
  rel="noopener"
  aria-label="Termin per WhatsApp vereinbaren"
  class="fixed right-5 bottom-[calc(1.25rem+env(safe-area-inset-bottom))] z-30 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/25 transition-transform active:scale-95 lg:hidden"
>
  <WhatsAppIcon class="h-7 w-7" />
</a>
