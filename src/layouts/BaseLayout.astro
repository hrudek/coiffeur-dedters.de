---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import ogImage from "../assets/team/team-salon.jpg";
import { getImage } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  /** Unterseiten wie /danke nicht indexieren */
  noindex?: boolean;
}

const defaultTitle = "Coiffeur Dedters – Friseur in Moers | Balayage & AirTouch";
const {
  title,
  description = "Coiffeur Dedters – dein Friseursalon in Moers. Spezialistinnen für Balayage & AirTouch in Moers, Schnitt, Farbe und Pflege mit Sebastian Professional. Termine nach Vereinbarung per Telefon oder WhatsApp.",
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | Coiffeur Dedters` : defaultTitle;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site);
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: "cover", format: "jpg" });
const ogUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#111111" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Coiffeur Dedters" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#inhalt"
      class="sr-only z-[60] bg-ink px-4 py-2 text-paper focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Zum Inhalt springen</a
    >
    <SiteNav />
    <div class="pt-16 lg:pt-0 lg:pl-sidebar">
      <main id="inhalt">
        <slot />
      </main>
      <Footer />
    </div>
    <WhatsAppFloat />
  </body>
</html>
